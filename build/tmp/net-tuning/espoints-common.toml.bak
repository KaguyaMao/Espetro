
["HUD Settings"]
	#启用HUD显示
	enableHUD = true
	#启用据点信息轮播
	enableCarousel = true

["Team Settings"]
	#兼容旧配置：HCRpoints 现在固定使用 Espetro 攻防阵营队伍
	enableTeams = true
	#在玩家头顶显示敌我标识（友军绿色箭头/敌军红色倒三角），需要队伍机制同时启用
	enableTeamIndicator = true

["Performance Settings"]
	#据点检查间隔（tick）
	#Range: 1 ~ 100
	checkInterval = 5
	#战术地图服务端编码瓦片内存缓存（MiB）
	#Range: 8 ~ 512
	tacticalMapServerMemoryMiB = 32
	#config/espoints/cache/tactical-map 磁盘预算（MiB）
	#Range: 64 ~ 4096
	tacticalMapDiskCacheMiB = 512
	#每名玩家战术地图瓦片传输预算（KiB/s）
	#Range: 32 ~ 4096
	tacticalMapPlayerTransferKiBps = 256
	#全服战术地图瓦片传输预算（KiB/s）
	#Range: 256 ~ 65536
	tacticalMapGlobalTransferKiBps = 4096

["Reward Settings"]
	#据点内获得点数的时间间隔（秒）
	#Range: 1 ~ 3600
	pointRewardInterval = 60
	#据点内每次获得的点数
	#Range: 1 ~ 1000
	pointRewardAmount = 5
	#击杀玩家获得的点数
	#Range: 1 ~ 1000
	killRewardAmount = 50
	#占领据点获得的点数
	#Range: 1 ~ 1000
	captureRewardAmount = 100
	#占领据点后，获得持续奖励的时间间隔（秒）
	#Range: 1 ~ 3600
	capturedRewardInterval = 60
	#占领据点后，每次获得的持续奖励点数
	#Range: 1 ~ 1000
	capturedRewardAmount = 10
	#占领据点后，开始获得持续奖励的延迟时间（秒）
	#Range: 1 ~ 3600
	capturedRewardDelay = 5
	#启用友军击杀惩罚
	enableFriendlyFirePenalty = true
	#友军击杀扣除的点数
	#Range: 1 ~ 10000
	friendlyFirePenalty = 200

["Operation Settings"]
	#兼容旧配置：HCRpoints 现在固定启用行动攻防机制
	enableOperationMode = true
	#当一方兵力低于此百分比时播放背水一战背景音乐（0-100，设置为0则不播放）
	#Range: 0.0 ~ 100.0
	lowReinforcementThreshold = 10.0

